# ---------------------------------------------------------------------------
# notify-bambuddy configuration
#
# Copy to `.env`, fill in the four required values, and leave the rest alone
# until something makes you want to change it. The defaults are chosen for a
# home setup with one to five printers.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it. It holds two credentials:
# NOTIFY_DEVICE_TOKEN, which lets anyone holding it push notifications and Lock
# Screen tiles to your phone, and BAMBUDDY_API_KEY, which lets anyone holding
# it read your BambuBuddy.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED: where to read printer state from, and where the tiles go
# ===========================================================================

# BambuBuddy's own address, exactly as you browse to it, with no trailing path.
# This service asks BambuBuddy for printer status over HTTP; it never talks to
# your printers and never asks BambuBuddy to do anything.
#
# If BambuBuddy runs in Docker on the same host, put this service on its
# network and use the service name:
#   BAMBUDDY_URL=http://bambuddy:8000
BAMBUDDY_URL=http://192.168.1.50:8000

# An API key from BambuBuddy:
#   Settings -> API Keys -> New key
#
# Give it the `read_status` permission and nothing else. That is the only one
# this service uses, and there is no code path here that calls a control
# endpoint. If your BambuBuddy scopes keys to specific printers, scoping the
# key is a better way to choose which printers appear than the settings below,
# because it is enforced at the source.
#
# This is a credential. It travels in an X-API-Key header, never in a URL, and
# is redacted from every log line this service writes.
BAMBUDDY_API_KEY=

# From the Notify app on the iPhone or iPad that should show the tiles:
#   Settings -> Device
#
# It must be a DEVICE, not a group. A Live Activity is a tile on one specific
# device, so a group credential cannot host one.
#
# Before this will work, on that device:
#   1. Install or update Notify to a version that supports Live Activities.
#   2. OPEN THE APP AT LEAST ONCE. That first launch registers the credential
#      that lets a tile be created while the app is closed. Without it, every
#      start is refused with an honest error.
# It must be a DEVICE, not a group: a Live Activity is a tile on one specific
# device, so a group credential cannot host one.
#
# A BROWSER subscription also works. Its id starts with `WB`, and because a
# Live Activity is an iOS Lock Screen feature there is no tile in that case.
# Every print is still followed and you still get a notification when one
# starts, finishes or fails. Nothing to set: it is worked out from the id.
#
NOTIFY_DEVICE_ID=ABC12345
NOTIFY_DEVICE_TOKEN=

# Both credentials also accept a `_FILE` form pointing at a mounted secret,
# which keeps the value out of the process environment and out of
# `docker inspect`:
#NOTIFY_DEVICE_TOKEN_FILE=/run/secrets/notify_token
#BAMBUDDY_API_KEY_FILE=/run/secrets/bambuddy_key


# ===========================================================================
# Polling
# ===========================================================================

# How often to ask, in seconds, while something is printing. Everything idle
# slows to eight times this with a 30 second floor, and a failing BambuBuddy
# backs off further, so the default costs a few small LAN requests a minute at
# its very busiest. Clamped to between 2 and 300.
#
# Polling faster does NOT cost more pushes to your phone. The tile's countdown
# is relative and iOS ticks it down on the device, so a whole print costs a
# handful of pushes whatever this is set to. What it does bound is how long a
# finished print can go unnoticed, and how short a print has to be to be missed
# entirely: one that starts and finishes between two polls is never seen.
#BAMBUDDY_POLL_SECONDS=10

# Watch only these printers, by BambuBuddy's own printer id, as shown in the
# startup log. Empty means every printer the API key can see.
#BAMBUDDY_PRINTER_IDS=1,3

# How often to re-check which printers exist, so one added in BambuBuddy is
# picked up without a restart. Seconds.
#BAMBUDDY_DISCOVERY_SECONDS=300

# HTTP timeout for a single request to BambuBuddy, in seconds.
#BAMBUDDY_TIMEOUT=10


# ===========================================================================
# Appearance
# ===========================================================================

# SF Symbol shown on the tile. Nothing validates this name anywhere in the
# stack, so a typo renders as a blank space with no error: check any
# replacement against the SF Symbols catalogue before using it.
#NOTIFY_SYMBOL=printer.fill

# Accent colour, #RRGGBB or #AARRGGBB. Note that the 8-digit form puts the
# ALPHA channel first, which is the opposite of the CSS convention.
#NOTIFY_TINT=#00A76F

# How long a finished tile lingers on the Lock Screen before disappearing,
# in seconds. 0 removes it immediately.
#NOTIFY_KEEP_FOR=300

# Show only the printer name, state, progress and ETA. Filenames and model
# names are left off the tile and out of the alerts entirely. For anyone
# whose Lock Screen is visible to other people.
#PRIVACY_MODE=false


# ===========================================================================
# Alerts
#
# Ordinary push notifications, sent alongside the tiles. They exist because a
# tile ends and disappears, and Live Activity updates are deliberately kept
# out of Notify's history so that a printer pushing percent every few minutes
# cannot bury everything else.
#
#   all       print finished, plus every problem below (default)
#   problems  failures, cancellations, pauses, unresponsive printers
#   off       tiles only
#
# A pause arrives with no cause attached, because the API reports no error
# codes, so the alert says "Paused" and nothing more.
# ===========================================================================

#ALERTS=all

# Send problem alerts at the Time Sensitive level, so they break through Do
# Not Disturb and Focus. Successful completions are never sent this way.
#ALERTS_TIME_SENSITIVE=true


# ===========================================================================
# Scope
# ===========================================================================

# Only these printers get tiles. Comma-separated session keys. Leave unset for
# all printers.
#
# A session key is `bb` followed by BambuBuddy's own database id for the
# printer, because the API exposes no serial. It stays the same when a printer
# is renamed. Prefer BAMBUDDY_PRINTER_IDS above, which takes plain ids and is
# checked before a request is even made.
#PRINTER_ALLOWLIST=bb1,bb3

# How many tiles to hold at once. Notify's limit is 5 live tiles per device,
# enforced by the gateway with a 400; set it lower to leave room for other
# tools sharing the same phone. A sixth printer is not dropped, it waits for a
# slot. A freed slot goes to a print that is actually running before a paused
# one, then to whichever is closest to done.
#MAX_TILES=5


# ===========================================================================
# Local plumbing
# ===========================================================================

# Where the print-to-tile mapping lives. PUT THIS ON A PERSISTENT VOLUME.
# Losing it means a restart cannot reattach to tiles that are still on the
# Lock Screen, cannot remember which ones you swiped away, and cannot tell
# whether a start that was in flight actually created a tile.
#
# Defaults to ~/.local/state/notify-bambuddy/state.db when run directly, which
# needs no privileges. The container image overrides it to /data and mounts a
# volume there.
#STATE_DB=/data/notify-bambuddy.db

# Diagnostics. Bound to localhost by default: it lists printer keys and job
# names, and the BAMBUDDY_URL you configured. Never a credential.
#   GET /healthz   liveness only
#   GET /readyz    at least one poll has ever succeeded and the most recent
#                  one did too
#   GET /status    sessions, tile budget, and a `source` object carrying the
#                  poll counters: how many printers are known and how many are
#                  polled, polls succeeded, events emitted, consecutive
#                  failures, the last error, seconds since the last success,
#                  and the interval currently in use
#HEALTH_ENABLED=true
#HEALTH_HOST=127.0.0.1
#HEALTH_PORT=9337

#LOG_LEVEL=INFO

# Track everything and log what WOULD be sent, without creating, updating or
# ending a single tile. Credential validation and status reads still happen,
# because those change nothing and are worth exercising. Useful for trying the
# BambuBuddy half against real printers first.
#DRY_RUN=false


# ===========================================================================
# Timing
#
# Every one of these has a reason to be the value it is. Changing them is
# supported but rarely necessary; see docs/CONFIGURATION.md.
# ===========================================================================

# Ignore any status reading older than this, in seconds. Every reading is
# answered live and stamped as it arrives, so its age is the round trip to
# BambuBuddy and this gate should not fire in normal running. It is a
# backstop: a reading that somehow does arrive stale would otherwise build a
# tile for a print that is already over.
#RETAINED_MAX_AGE=180

# No telemetry for this long means the numbers on the tile stopped being true,
# and the tile says "Connection lost" instead of freezing a number.
#SILENCE_AFTER=90

# No telemetry for THIS long means the print is not coming back, and the tile
# is ended. Without it, a printer switched off at the wall and left off would
# keep a tile alive until Apple's 8 hour ceiling, because nothing is ever
# going to report that print as ended.
#ABANDON_AFTER=1800

# How long a printer must keep reporting a running print before a tile is
# created for it. Starts are observed rather than announced, so this filters
# out a printer that only flickers through a running state.
#RUNNING_GRACE=20

# Floor between routine progress updates, in seconds.
#PROGRESS_MIN_INTERVAL=15

# Unconditional refresh interval. Keeps Notify's own housekeeping from ending
# a healthy tile. Must stay well under two hours.
#KEEPALIVE_INTERVAL=1200

# How long a finished print's outcome is held before the tile is ended. The
# outcome is inferred from the state a printer reports as it goes inactive,
# and a printer can report an unhelpful state on its way to FINISH, so this
# window lets a real completion overrule a spurious "aborted".
#TERMINAL_HOLD=120

# How long after starting a tile to check that it actually appeared on the
# phone. A start can be accepted everywhere and still silently produce
# nothing.
#START_VERIFY_AFTER=90

# Replace a tile at this age, in seconds. Apple ends every Live Activity at 8
# hours (28800) no matter what; the default rolls over at 7.5 hours.
#ROLLOVER_AFTER=27000

# Ignore a pause in the first few seconds of a print. BambuBuddy's own plate
# detection can pause a print seconds after it starts.
#PAUSE_SUPPRESS=15
